# Lawgic RAG Backend — Environment Variables
# Copy this file to .env and fill in your values.
# The docker-compose.yml already sets most of these via the `environment` block.
# Use .env for local development (without Docker).

# ─── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=phi4-mini
EMBED_MODEL=nomic-embed-text
LLM_REQUEST_TIMEOUT=300.0

# ─── RAG Tuning ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SIMILARITY_TOP_K=5

# ─── API ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://lawgic-phi.vercel.app
MAX_UPLOAD_SIZE_MB=50

# ─── Email & Password Reset (Production SMTP) ────────────────────────────────
# Production Frontend URL used in password reset links (e.g., https://lawgic-phi.vercel.app or http://localhost:3000)
FRONTEND_URL=https://lawgic-phi.vercel.app

# SMTP Provider configuration (SendGrid, AWS SES, Resend, Mailgun, Postmark, Google Workspace, etc.)
# If SMTP_HOST is left empty, the application runs in offline mode without crashing.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_or_password
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT=10
FROM_EMAIL=security@lawgic.ai
FROM_NAME=LAWGIC Security
PASSWORD_RESET_EXPIRE_MINUTES=15
