# Lawgic RAG Backend — Environment Variables
# Copy this file to .env and fill in your values.
# The docker-compose.yml already sets most of these via the `environment` block.
# Use .env for local development (without Docker).

# ─── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=phi4-mini
EMBED_MODEL=nomic-embed-text
LLM_REQUEST_TIMEOUT=300.0

# ─── RAG Tuning ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SIMILARITY_TOP_K=5

# ─── API ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,https://lawgic-phi.vercel.app
MAX_UPLOAD_SIZE_MB=50
